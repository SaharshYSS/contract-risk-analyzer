{
  "name": "contract-risk-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node scripts/run-sql.mjs",
    "db:queries": "node scripts/run-sql.mjs database/07_queries.sql",
    "vector:setup": "node scripts/run-sql.mjs --pg database/pgvector/01_vector_schema.sql",
    "vector:seed": "tsx vector/seed_risk_patterns.ts",
