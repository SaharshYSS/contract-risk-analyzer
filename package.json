    "vector:tune": "tsx vector/tune_threshold.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.1",
    "jose": "^6.0.12",
    "mysql2": "^3.14.3",
    "next": "^15.5.29",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5"
  }
