# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL (relational database)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=contract_analysis

# PostgreSQL + pgvector (vector database)
#   Docker:  postgres://postgres:change_me@localhost:5432/contract_vectors
#   Neon / Supabase: paste their connection string (keep ?sslmode=require)
PG_PASSWORD=change_me
PG_URL=postgres://postgres:change_me@localhost:5432/contract_vectors

# Session signing secret: any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string_of_at_least_32_chars

# Embeddings + risk detection
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
RISK_SIMILARITY_THRESHOLD=0.6
